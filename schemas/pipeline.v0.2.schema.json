{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pipeline v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pipeline"
  ],
  "properties": {
    "format_version": {
      "type": "string",
      "enum": [
        "0.1",
        "0.2"
      ]
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "steps"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "type": "object",
          "additionalProperties": {}
        },
        "foreach": {
          "type": "string",
          "pattern": "^(input|steps)\\."
        },
        "foreach_item": {
          "type": "string"
        },
        "item_type": {
          "type": "string",
          "enum": [
            "string",
            "number",
            "boolean",
            "array",
            "object"
          ]
        },
        "item_format": {
          "type": "string",
          "enum": [
            "text",
            "email",
            "url",
            "ip",
            "file_ref"
          ]
        },
        "gates": {
          "type": "string",
          "enum": ["human_only", "any"]
        },
        "schedule": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cron"],
          "properties": {
            "cron": {
              "type": "string",
              "description": "cron 5 полей: \"0 9 * * *\""
            },
            "timezone": {
              "type": "string",
              "description": "IANA таймзона, напр. Europe/Minsk или UTC"
            },
            "enabled": {
              "type": "boolean",
              "description": "выключен = пайплайн как соло"
            },
            "overlap": {
              "type": "string",
              "enum": ["skip", "queue", "allow"],
              "description": "что делать если предыдущий ран еще идет"
            },
            "catch_up": {
              "type": "boolean",
              "description": "догнать пропущенное если сервер был выключен"
            },
            "human_gate": {
              "type": "string",
              "enum": ["autoApprove", "wait", "auto_approve"],
              "description": "как вести себя на human_gate при кроне"
            },
            "alerts": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "on_waiting": {"type": "string"},
                "on_failure": {"type": "string"},
                "webhook": {"type": "string"}
              }
            }
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "plugin"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
              },
              "plugin": {
                "type": "string",
                "minLength": 1
              },
              "pos": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {"type": "number"}
              },
              "on_error": {
                "type": "string",
                "enum": [
                  "stop",
                  "skip",
                  "retry"
                ]
              },
              "on_reject": {
                "type": "string",
                "enum": [
                  "stop",
                  "continue"
                ]
              },
              "approval": {
                "type": "string",
                "enum": ["human", "any"]
              },
              "timeout": {
                "type": "string"
              },
              "bind": {
                "type": "object",
                "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^(input|steps)\\."
                }
              },
              "form": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "field"
                  ],
                  "properties": {
                    "field": {
                      "type": "string",
                      "pattern": "^(input|steps)\\."
                    },
                    "editable": {
                      "type": "boolean"
                    },
                    "type": {
                      "type": "string",
                      "enum": ["string", "number", "boolean", "array", "object"]
                    },
                    "format": {
                      "type": "string",
                      "enum": ["text", "email", "url", "ip", "file_ref"]
                    }
                  }
                }
              },
              "actions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": ["accept", "reject"]
                }
              },
              "retry": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "attempts": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10
                  },
                  "delay": {
                    "type": "string"
                  },
                  "backoff": {
                    "type": "string",
                    "enum": [
                      "fixed",
                      "exponential"
                    ]
                  }
                }
              },
              "after_foreach": {
                "type": "boolean",
                "description": "шаг выполняется один раз после foreach-цикла"
              },
              "when": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^(input|steps)\\.",
                    "description": "путь: шаг выполняется, если значение истинно"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "path"
                    ],
                    "properties": {
                      "path": {
                        "type": "string",
                        "pattern": "^(input|steps)\\."
                      },
                      "op": {
                        "type": "string",
                        "enum": [
                          "truthy",
                          "exists",
                          "missing",
                          "eq",
                          "neq",
                          "gt",
                          "gte",
                          "lt",
                          "lte",
                          "contains"
                        ]
                      },
                      "value": {}
                    },
                    "description": "path + оператор + значение (op по умолчанию eq)"
                  }
                ]
              },
              "foreach": {
                "type": "string",
                "pattern": "^(input|steps)\\.",
                "description": "шаг выполняется по каждому элементу массива; результаты — steps.<id>_all"
              },
              "foreach_item": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                "description": "имя переменной элемента в input.* (по умолчанию item)"
              },
              "parallel_group": {
                "type": "string",
                "description": "шаги с одинаковым именем группы выполняются параллельно, барьер — до следующего шага"
              },
              "loop": {
                "type": "string",
                "description": "пока loop_condition истинно, повторять группу шагов loop_steps; пусто — цикла нет. Источник loop_condition — путь в контексте (например steps.parser.found). Жёсткий предел MaxLoopIterations=100, суммарный бюджет MaxTotalLoopBudget=1000 (internal/pipeline/model.go)"
              },
              "loop_condition": {
                "type": "string",
                "pattern": "^(input|steps)\\.",
                "description": "путь к значению, которое читается как «продолжать ли цикл»"
              },
              "max_iterations": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100,
                "description": "потолок повторов в пределах MaxLoopIterations=100"
              }
            }
          }
        },
        "secrets": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "description": "v0.16: имена env-переменных, обязанных быть заданы (значения в YAML не живут)"
        },
        "network": {
          "type": "string",
          "enum": [
            "allow",
            "deny"
          ],
          "description": "v0.17: declare-now — deny запрещает шаги, чей плагин заявил permissions.network"
        }
      }
    }
  }
}