# Контекст сборки образа.
#
# Без этого в образ попадают .git (десятки мегабайт), локальные раны, ключ
# подписи ссылок одобрения и артефакты прошлых сборок. Последнее важно
# отдельно: approve.key — это право одобрять гейты, и в образе ему не место.

.git
.gitignore
.golangci.yml

# Локальные данные и артефакты
var/
runs/
dist/
*.exe
*.log
*.key
approve.key

# CI и выпуск
.github/
.gitea/

# Редактор и ОС
.vscode/
.idea/
.DS_Store
Thumbs.db

# Документы, не нужные в образе (доки живут в репозитории)
archive/
